# Python
__pycache__/
*.py[cod]
.venv/

# 本地 LLM 配置（含明文 Key，不要提交）
config/llm.local.json
config/llm.local.json.tmp

# 规则启停状态（运行时生成）
config/rules.state.json
config/rules.state.json.tmp

# 历史报告收藏（个人使用偏好，运行时生成）
config/favorites.json
config/favorites.json.tmp

# 运行日志
logs/console-boot.log

# review_id 分配锁（正常会自动删除，异常退出时遗留）
outputs/.R-*.lock

# 控制台上传的待审文件
targets/uploads/

# 系统
.DS_Store
Thumbs.db

cache/

# ---------- 以下为公开仓库排除项（仅推源码与核心文档） ----------
# 审查运行产物
outputs/
ledger/
logs/
docs/*.png
docs/*.jpg

# 测试/对抗样本与报告（含系统漏洞细节，不公开）
targets/
tests/fixtures_v3/
tests/*.log
tests/net_probe.txt
对抗测试·第二轮·系统漏洞报告.md
对抗测试·第三轮·系统漏洞报告.md
对抗测试·错误植入对照表.md
方案诊断报告.md
压力测试报告·长文本审查.md
诊断全景图.html

# 本地工具状态
.workbuddy/
agents/

# 运行态：标注、候选、审计、快照不进版本库（含标注人身份）
state/

# ---------- 2026-10-27 公开推送补充排除（用户要求：不上传测试文件和相关报告） ----------
# 用 `tests/*` 而不是 `tests/`：目录本身不排除，才能在下面把金标准集单独捞回来。
# 金标准集是「判定基准」（数据），不是测试实现——它必须随仓库走，
# 否则换台机器就没有"改规则前先看这个数"的底线了。
tests/*
!tests/golden/
!tests/golden/**
targets/
config/llm_history.json
config/learning.json
config/report_order.json
docs/修复报告-*.md
docs/本地模型实测报告.md
docs/盲测协议.md
回归测试·*.md
对抗测试·*.md
暴力测试·*.md
格式合规测试·*.md
调教报告·*.md
测试结果面板/
裁定结果样本/
